"""Public ontology API."""

from . import HDict

class DefKind:
    """Classification of a Haystack definition."""
    Marker: DefKind
    Val: DefKind
    Entity: DefKind
    Feature: DefKind
    Conjunct: DefKind
    Choice: DefKind
    Lib: DefKind
    def __repr__(self) -> str: ...


class Slot:
    """Resolved Xeto slot; all properties are read-only."""
    @property
    def name(self) -> str: ...
    @property
    def type_ref(self) -> str | None: ...
    @property
    def is_marker(self) -> bool: ...
    @property
    def is_query(self) -> bool: ...
    @property
    def is_maybe(self) -> bool: ...
    def __repr__(self) -> str: ...

class Spec:
    @property
    def qname(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def lib(self) -> str: ...
    @property
    def base(self) -> str | None: ...
    @property
    def doc(self) -> str: ...
    @property
    def is_abstract(self) -> bool: ...
    @property
    def slots(self) -> list[Slot]: ...
    def markers(self) -> list[str]: ...
    def mandatory_markers(self) -> list[str]: ...
    def __repr__(self) -> str: ...

class Def:
    @property
    def symbol(self) -> str: ...
    @property
    def lib(self) -> str: ...
    @property
    def is_(self) -> list[str]: ...
    @property
    def kind(self) -> DefKind: ...
    @property
    def doc(self) -> str: ...
    @property
    def tag_on(self) -> list[str]: ...
    @property
    def of(self) -> str | None: ...
    @property
    def mandatory(self) -> bool: ...
    @property
    def tags(self) -> HDict: ...
    def __repr__(self) -> str: ...

class Lib:
    """A Haystack library containing definitions."""
    @property
    def name(self) -> str: ...
    @property
    def version(self) -> str: ...
    @property
    def doc(self) -> str: ...
    @property
    def depends(self) -> list[str]: ...
    def defs(self) -> list[Def]: ...
    def get_def(self, symbol: str) -> Def | None: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...


class DefNamespace:
    """Haystack definition namespace with taxonomy, validation, and spec resolution."""
    def __init__(self) -> None: ...
    @staticmethod
    def load_standard() -> DefNamespace: ...
    def validate_entity(self, entity: HDict) -> list[str]: ...
    def subtypes(self, name: str) -> list[str]: ...
    def supertypes(self, name: str) -> list[str]: ...
    def contains(self, name: str) -> bool: ...
    def __len__(self) -> int: ...
    def load_xeto(self, source: str, lib_name: str) -> list[str]: ...
    def unload_lib(self, name: str) -> None: ...
    def get_spec(self, qname: str) -> Spec | None: ...
    def specs(self, lib: str | None) -> list[Spec]: ...
    def export_lib_xeto(self, lib_name: str) -> str: ...
    def is_a(self, name: str, supertype: str) -> bool:
        """Nominal subtype relationship between two type names."""
        ...
    def entity_is_a(self, entity: HDict, type_name: str) -> bool:
        """Membership: is this entity a type_name?

        True when the entity carries a marker tag whose def is type_name or a
        subtype of it. This is what a `ph::X` filter term evaluates.
        """
        ...
    def fits(self, entity: HDict, type_name: str) -> bool:
        """Conformance: does this entity carry all of type_name's mandatory markers?

        Not the same question as entity_is_a. 579 of the 719 standard defs have
        no mandatory markers, so this is True against them for any entity at
        all — including an empty one.
        """
        ...
    def fits_explain(self, entity: HDict, type_name: str) -> list[str]:
        """Why entity does not conform to type_name; empty when it does."""
        ...
    def get_def(self, symbol: str) -> Def | None: ...
    def mandatory_tags(self, name: str) -> list[str]: ...
    def tags_for(self, name: str) -> list[str]: ...
    def choices(self, choice_name: str) -> list[str]: ...
    def defs(self) -> list[Def]: ...
    def libs(self) -> list[Lib]: ...
    def get_lib(self, name: str) -> Lib | None: ...
    def __repr__(self) -> str: ...
